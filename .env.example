# Application Configuration
APP_NAME="VaxAssist AI"
ENVIRONMENT="development"
DEBUG=True

# Backend Server Configuration
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# MongoDB Primary Database Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="vaxassist_db"

# ChromaDB Vector Database Configuration (Knowledge Base Only)
CHROMADB_HOST="localhost"
CHROMADB_PORT=8001

# AI / LLM Configuration (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
